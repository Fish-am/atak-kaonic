<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Header with back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#161B22"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ BACK"
            android:textColor="#39FF88"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:id="@+id/detailCallsign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORB-01"
                android:textColor="#E6EDF3"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="blank · GPS-denied"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:id="@+id/detailStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#39FF88" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Telemetry grid -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TELEMETRY"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#161B22"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATTERY"
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/detailBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="87%"
                        android:textColor="#39FF88"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALTITUDE"
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/detailAltitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="142 ft"
                        android:textColor="#E6EDF3"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#161B22"
                android:padding="14dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED"
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/detailSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12.4 mph"
                        android:textColor="#E6EDF3"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LINK"
                        android:textColor="#8B949E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/detailLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strong"
                        android:textColor="#39FF88"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Position -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POSITION"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/detailPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="37.4120° N, -122.0110° W"
                android:textColor="#E6EDF3"
                android:textSize="14sp"
                android:background="#161B22"
                android:padding="14dp" />

            <!-- Controls -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTROL"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:paddingTop="16dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/armButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ARM"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="14dp"
                    android:background="#CF3D4A"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/holdButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HOLD"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="14dp"
                    android:background="#2A6FB5"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/rtlButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISARM"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="14dp"
                    android:background="#B5832A"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Controls are not yet connected to flight hardware"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:gravity="center"
                android:paddingTop="10dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>